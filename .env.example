# ─── Real Estate Negotiation Workshop — Environment Variables ─────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env to git (it's already in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ─── OpenAI API Key ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── GitHub Token (for M1 GitHub MCP demo only) ─────────────────────────────
# Required for: python m1_mcp/github_agent_client.py
# Get a token: GitHub → Settings → Developer Settings → Personal Access Tokens
GITHUB_TOKEN=ghp_your-github-token-here

# ─── Pricing MCP server auth (Streamable HTTP mode + ADK demo d02) ──────────
# Secret used to sign and verify the demo JWTs (utils/pricing_auth.py).
# Use at least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
PRICING_JWT_SECRET=replace-with-at-least-32-random-characters
# Token d02 sends to the server. Don't type it — mint it:
#   python utils/pricing_auth.py --role buyer --write-env     (or --role analyst)
# PRICING_MCP_TOKEN=
# PRICING_MCP_URL=http://127.0.0.1:8001/mcp

# ─── Agent Model ─────────────────────────────────────────────────────────────
# Change to openai/gpt-4o-mini for cheaper runs (default: openai/gpt-4o)
# AGENT_MODEL=openai/gpt-4o
